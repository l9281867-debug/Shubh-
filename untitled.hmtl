<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>IMPORTANT ANNOUNCEMENT 💌</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    font-family: "Trebuchet MS", Arial, sans-serif;
    background: linear-gradient(135deg, #ffd6e7, #f7c8ff, #d9d7ff);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    color: #4b2142;
}

/* FALLING HEARTS */

.heart {
    position: fixed;
    top: -30px;
    pointer-events: none;
    animation: fall linear forwards;
    z-index: 1;
}

@keyframes fall {
    from {
        transform: translateY(-30px) rotate(0deg);
        opacity: 1;
    }

    to {
        transform: translateY(110vh) rotate(360deg);
        opacity: 0;
    }
}

/* MAIN CARD */

.card {
    position: relative;
    z-index: 5;
    width: min(92%, 520px);
    max-height: 90vh;
    overflow-y: auto;

    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(15px);

    border-radius: 30px;
    padding: 32px 25px;

    text-align: center;

    box-shadow:
        0 20px 60px rgba(104,52,100,0.25);

    border: 2px solid white;
}

/* BADGE */

.badge {
    display: inline-block;

    background: #ff5c91;
    color: white;

    padding: 8px 16px;

    border-radius: 50px;

    font-size: 13px;
    font-weight: bold;

    letter-spacing: 1px;

    margin-bottom: 18px;
}

h1 {
    font-size: 30px;
    margin-bottom: 15px;
}

h2 {
    font-size: 25px;
    margin-bottom: 15px;
}

p {
    font-size: 16px;
    line-height: 1.7;
    margin: 12px 0;
}

.small {
    font-size: 13px;
    opacity: 0.7;
}

/* PAGES */

.page {
    display: none;
    animation: pageIn 0.55s ease;
}

.page.active {
    display: block;
}

@keyframes pageIn {

    from {
        opacity: 0;
        transform: translateX(25px) scale(0.97);
    }

    to {
        opacity: 1;
        transform: translateX(0) scale(1);
    }
}

/* BUTTONS */

button {
    border: none;
    cursor: pointer;

    padding: 13px 22px;

    border-radius: 50px;

    font-size: 15px;
    font-weight: bold;

    margin: 8px 5px;

    transition: 0.25s;

    font-family: inherit;
}

.main-btn {
    background: #ff5c91;
    color: white;

    box-shadow:
        0 7px 18px rgba(255,92,145,0.3);
}

.main-btn:hover {
    transform: scale(1.06);
}

.main-btn:active {
    transform: scale(0.95);
}

.danger-btn {
    background: #292929;
    color: white;
}

.back-btn {
    background: #f1dce9;
    color: #64284e;
}

/* TYPING */

.typing {
    min-height: 30px;

    font-weight: bold;

    color: #d63f76;

    margin-bottom: 20px;
}

/* NOTICE */

.notice {
    background: #fff0f6;

    border-radius: 20px;

    padding: 18px;

    margin: 18px 0;

    border: 1px solid #ffd1e2;
}

/* INSTRUCTIONS */

.instruction {
    background: #fff6df;

    border-radius: 18px;

    padding: 16px;

    margin: 10px 0;

    text-align: left;
}

.instruction strong {
    color: #d95c00;
}

/* SECRET */

.secret-box {
    margin-top: 20px;

    padding: 18px;

    border-radius: 20px;

    background: #f7edff;

    border: 2px dashed #c27cff;
}

.secret-message {
    display: none;

    margin-top: 15px;

    animation: reveal 0.8s ease;
}

.secret-message.show {
    display: block;
}

@keyframes reveal {

    from {
        opacity: 0;
        transform: scale(0.8);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}

/* DOTS */

.dots {
    margin-top: 22px;
}

.dot {
    display: inline-block;

    width: 8px;
    height: 8px;

    background: #d9b8ca;

    border-radius: 50%;

    margin: 4px;
}

.dot.active {
    background: #ff5c91;

    transform: scale(1.3);
}

/* FINAL HEART */

.final-heart {
    font-size: 65px;

    animation: heartbeat 1.2s infinite;

    margin: 10px;
}

@keyframes heartbeat {

    0%,100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.18);
    }
}

.signature {
    margin-top: 22px;

    font-weight: bold;

    color: #d63f76;

    font-size: 18px;
}

/* FUNNY BUTTON */

.trouble {
    min-height: 70px;

    margin: 15px 0;
}

/* CONFETTI */

.confetti {
    position: fixed;

    top: -20px;

    width: 8px;
    height: 14px;

    z-index: 20;

    animation:
        confettiFall 2.5s linear forwards;
}

@keyframes confettiFall {

    to {
        transform:
            translateY(110vh)
            rotate(720deg);

        opacity: 0;
    }
}

/* MOBILE */

@media(max-width:500px) {

    .card {
        padding: 27px 18px;
    }

    h1 {
        font-size: 25px;
    }

    h2 {
        font-size: 22px;
    }

    p {
        font-size: 15px;
    }
}
</style>
</head>


<body>

<div class="card">


<!-- PAGE 1 -->

<section class="page active" id="page1">

<div class="badge">
📢 IMPORTANT ANNOUNCEMENT
</div>

<h1>
Hey, Shubhh. 👀💗
</h1>

<div class="typing" id="typing"></div>

<div class="notice">

<p>
This is an <strong>official reminder</strong>
that you have someone who currently
misses you very much. 🥹
</p>

<p>
However, she has decided to be responsible
and allow you to finish your work first. 😤
</p>

</div>

<p>
Please continue your work without
unnecessary distractions.
</p>

<p class="small">

(Yes, this message itself is technically
a distraction.) 😭

</p>


<div class="trouble">

<button
class="danger-btn"
id="noButton"
onclick="dontClick()">

🚫 DO NOT CLICK

</button>

</div>


<button
class="main-btn"
onclick="nextPage(2)">

I understand 😭 ➜

</button>

</section>



<!-- PAGE 2 -->

<section class="page" id="page2">

<div class="badge">
🚨 VERY IMPORTANT INSTRUCTIONS
</div>

<h2>
YOUR MISSION 🫡
</h2>


<div class="instruction">

<strong>MISSION 01:</strong>

<br>

Finish your work. 😤

</div>


<div class="instruction">

<strong>MISSION 02:</strong>

<br>

Don't procrastinate. 👀

</div>


<div class="instruction">

<strong>MISSION 03:</strong>

<br>

Remember that someone is waiting
for you. 🥹💗

</div>


<div class="instruction">

<strong>MISSION 04:</strong>

<br>

RETURN IMMEDIATELY AFTER COMPLETION. 🚨

</div>


<p>

Failure to complete the mission may
result in excessive teasing. 😌

</p>


<button
class="main-btn"
onclick="nextPage(3)">

Mission accepted 🫡

</button>


<button
class="back-btn"
onclick="nextPage(1)">

← Back

</button>

</section>



<!-- PAGE 3 -->

<section class="page" id="page3">

<div class="badge">
🎉 ACCESS GRANTED
</div>

<h2>
CONGRATULATIONS! 🥳
</h2>


<p>

You have successfully completed
the extremely important procedure of

<strong>doing your work.</strong>

😭👏

</p>


<div class="notice">

<h3>
🎁 YOUR REWARD
</h3>

<p>

💗 UNLIMITED ATTENTION

<br>

💗 Random conversations

<br>

💗 Teasing privileges

<br>

💗 "I missed you" privileges

<br>

💗 Maximum cuteness

</p>

</div>


<p class="small">

Terms & Conditions:

Reward cannot be exchanged,
refunded, cancelled or transferred. 😌

</p>


<button
class="main-btn"
onclick="nextPage(4)">

Claim reward 💌

</button>


<button
class="back-btn"
onclick="nextPage(2)">

← Back

</button>

</section>



<!-- PAGE 4 -->

<section class="page" id="page4">

<div class="badge">
🥹 ONE LAST THING...
</div>


<div class="final-heart">
💗
</div>


<h2>
You made it here.
</h2>


<p>

So here's the part that isn't an
announcement, an instruction,
or a joke.

</p>


<p>

Even when you're busy,
you're still one of my favourite thoughts.

</p>


<p>

I hope you finish everything you need
to do and remember that someone is
quietly cheering for you. 🥹

</p>


<p>

Now go make me proud, Shubhh. 💗

</p>


<div class="secret-box">

<strong>
🔐 SECRET MESSAGE
</strong>


<p class="small">

There is one final message hidden here...

</p>


<button
class="main-btn"
onclick="unlockSecret(this)">

Tap 3 times to unlock 🔐

</button>


<div
class="secret-message"
id="secret">

<p>

🥹💗 No matter how busy the day gets,
I hope you always remember that
you're important to me.

</p>


<p>

Now stop reading this and go finish
your work. 😭👉

</p>


<p class="signature">

— Your annoying little reminder 💗

</p>

</div>

</div>


<button
class="back-btn"
onclick="nextPage(3)">

← Back

</button>

</section>



<!-- PAGE DOTS -->

<div class="dots">

<span class="dot active" id="dot1"></span>

<span class="dot" id="dot2"></span>

<span class="dot" id="dot3"></span>

<span class="dot" id="dot4"></span>

</div>

</div>



<script>

/* PAGE SWITCHING */

function nextPage(number) {

document
.querySelectorAll(".page")
.forEach(page => {

page.classList.remove("active");

});


document
.getElementById("page" + number)
.classList.add("active");


document
.querySelectorAll(".dot")
.forEach(dot => {

dot.classList.remove("active");

});


document
.getElementById("dot" + number)
.classList.add("active");

}



/* TYPING ANIMATION */

const messages = [

"Please read this very carefully... 👀",

"This is extremely serious. 🚨",

"Okay fine... maybe not THAT serious. 😭",

"But I miss you. 💗"

];


let messageIndex = 0;

let charIndex = 0;

let deleting = false;


function typeEffect() {

const element =
document.getElementById("typing");

const current =
messages[messageIndex];


if (!deleting) {

element.textContent =
current.substring(0,charIndex + 1);

charIndex++;


if (charIndex === current.length) {

deleting = true;

setTimeout(typeEffect,1300);

return;

}

}

else {

element.textContent =
current.substring(0,charIndex - 1);

charIndex--;


if (charIndex === 0) {

deleting = false;

messageIndex++;

if (messageIndex >= messages.length) {

messageIndex = 0;

}

}

}


setTimeout(
typeEffect,
deleting ? 35 : 60
);

}


typeEffect();



/* DO NOT CLICK BUTTON */

let clickCount = 0;


function dontClick() {

clickCount++;


const button =
document.getElementById("noButton");


const messages = [

"I TOLD YOU 😭",

"BRO WHY ARE YOU LIKE THIS 💀",

"YOU REALLY HAD ONE JOB 😭",

"SHUBHHH STOPPP 😭🤚",

"Okay fine, you win. 🙄💗"

];


button.textContent =
messages[
Math.min(
clickCount - 1,
messages.length - 1
)
];


button.style.transform =

"translateX(" +

(Math.random() * 100 - 50) +

"px) rotate(" +

(Math.random() * 16 - 8) +

"deg)";


createHearts(5);

}



/* SECRET MESSAGE */

let secretClicks = 0;


function unlockSecret(button) {

secretClicks++;


if (secretClicks < 3) {

button.textContent =

"Again 👀 (" +

(3 - secretClicks) +

" left)";

}

else {

document
.getElementById("secret")
.classList.add("show");


button.textContent =
"🔓 UNLOCKED";


createConfetti(45);

createHearts(20);

}

}



/* FALLING HEARTS */

function createHearts(amount = 1) {

for (
let i = 0;
i < amount;
i++
) {

const heart =
document.createElement("div");


heart.className = "heart";


heart.textContent =

["💗","💖","💕","💞","💓"]
[
Math.floor(
Math.random() * 5
)
];


heart.style.left =

Math.random() * 100 + "vw";


heart.style.fontSize =

12 + Math.random() * 18 + "px";


heart.style.animationDuration =

3 + Math.random() * 4 + "s";


document.body.appendChild(heart);


setTimeout(() => {

heart.remove();

},8000);

}

}



/* CONFETTI */

function createConfetti(amount) {

for (
let i = 0;
i < amount;
i++
) {

const piece =
document.createElement("div");


piece.className =
"confetti";


piece.style.left =

Math.random() * 100 + "vw";


piece.style.animationDelay =

Math.random() * 0.8 + "s";


piece.style.background =

"hsl(" +

Math.random() * 360 +

",80%,65%)";


document.body.appendChild(piece);

echo "# Shubh-" >> README.md
git init
git add README.md
git commit -m "first commit"
git branch -M main
git remote add origin https://github.com/l9281867-debug/Shubh-.git
git push -u origin main
setTimeout(() => {

piece.remove();

},3500);

}

}



/* CONSTANT HEARTS */

setInterval(() => {

createHearts(1);

},650);

</script>

</body>
</html>